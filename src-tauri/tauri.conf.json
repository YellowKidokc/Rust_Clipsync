{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipSync",
  "version": "0.1.0",
  "identifier": "pro.theophysics.clipsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ClipSync",
        "url": "desktop.html",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 400,
        "visible": false,
        "center": true
      },
      {
        "label": "picker",
        "title": "ClipSync Picker",
        "url": "picker.html",
        "width": 560,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
