   "lean": "accept",
   "then_accept": "a.state = 'turn'",
   "then_refuse": "a.state = 'away'",
   "to_refuse": "world",
   "say": "{a} answers from inside: {choice}.",
   "handle": "inside",
   "door": "The handle is on the inside. Only the person opens it; both answers are allowed from the same state.",
   "warrant": "admitted (revelation); M-FREEDOM admitted",
   "receipt": "Grace001Consent.lean: both_responses_permitted, only_person_responds"
  },
  {
   "id": "K",
   "label": "Pay the cost",
   "actor": "son",
   "target": "person",
   "when": "t.debt > 0",
   "then": "t.debt = 0",
   "say": "The Son pays {t}'s cost. Payment does not open the door.",
   "door": "May come before or after the answer; it never opens the door.",
   "warrant": "admitted (revelation)",
   "receipt": "Law5JusticeMercy.lean: cross_conserves, cross_unique"
  },
  {
   "id": "ENTER",
   "label": "Enter Growth",
   "actor": "father",
   "target": "person",
   "from": "resp",
   "when": "t.state == 'turn' and t.debt == 0",
   "then": "t.state = 'grow'",
   "to": "grow",
   "say": "{t} enters Growth, which opens only after acceptance and a paid cost.",
   "door": "Only after an accepted answer and a discharged cost.",
   "warrant": "admitted (revelation)",
   "receipt": "Grace001Consent.lean: refusal_blocks_restoration, response_then_restoration"
  },
  {
   "id": "G",
   "label": "Restore",
   "actor": "father",
   "target": "person",
   "from": "grow",
   "when": "t.state == 'grow' and t.c_spiritual < 1",
   "then": "t.c_spiritual = round(min(1, (t.c_spiritual + 1) / 2), 3)",
   "say": "Father through Son restores {t}: coherence grows.",
   "warrant": "admitted (revelation)",
   "receipt": "grace_model.py: restore"
  },
  {
   "id": "WALK",
   "label": "Walk to the Wall",
   "actor": "person",
   "from": "world",
   "when": "a.state == 'away'",
   "to": "wall",
