{
  "name": "clipsync-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [
    { "binding": "RELAY_DB", "database_name": "clipsync-relay", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "CLIP_BLOBS", "bucket_name": "clipsync-ciphertext" }],
  "durable_objects": { "bindings": [{ "name": "ACCOUNT_EVENTS", "class_name": "AccountEvents" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountEvents"] }]
}
