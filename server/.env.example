# Copy to .env on the NAS. Never commit .env.
# Postgres already running on the NAS. Create the DB once:
#   CREATE DATABASE clipsync; CREATE USER clipsync WITH PASSWORD '…'; GRANT ALL ON DATABASE clipsync TO clipsync;
# For meaning-based search also run (as superuser, in the clipsync DB): CREATE EXTENSION vector;
DATABASE_URL=postgres://clipsync:CHANGE_ME@192.168.1.177:2665/clipsync

# Cloudflare Worker (the hot window). The vault polls it; no open port needed.
WORKER_URL=https://api.example.workers.dev
# Shared secret between Worker and vault for /api/sync/*. Same value as the Worker's VAULT_SYNC_TOKEN.
SYNC_TOKEN=
SYNC_INTERVAL_SEC=30

# Ollama on the LAN for embeddings + the organizer
OLLAMA_URL=http://192.168.1.177:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
TRIAGE_MODEL=qwen2.5:14b
AI_INTERVAL_SEC=300
AI_ENABLED=1
TRIAGE_ENABLED=1
# 1 = file prompt/template/snippet suggestions straight into the library without review
TRIAGE_AUTO_APPLY=0

# Only with `--profile tunnel`
TUNNEL_TOKEN=
